{
    "name": "@stabrise/scaledp",
    "version": "0.1.0",
    "description": "Process documents (PDF, images) in the browser using AI/ML pipelines: OCR, text detection, and NER on onnxruntime-web. A browser mirror of the ScaleDP Python library.",
    "keywords": [
        "ocr",
        "pdf",
        "ner",
        "gliner",
        "onnx",
        "onnxruntime-web",
        "webgpu",
        "wasm",
        "document-processing",
        "pii",
        "paddleocr",
        "tesseract",
        "browser"
    ],
    "homepage": "https://stabrise.com/scaledp/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/StabRise/scaledp-ts.git"
    },
    "bugs": "https://github.com/StabRise/scaledp-ts/issues",
    "license": "AGPL-3.0-or-later",
    "author": "StabRise",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "workspaces": [
        "examples/*"
    ],
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./pdf": {
            "types": "./dist/pdf/index.d.ts",
            "import": "./dist/pdf/index.js"
        },
        "./ocr": {
            "types": "./dist/ocr/index.d.ts",
            "import": "./dist/ocr/index.js"
        },
        "./ner": {
            "types": "./dist/ner/index.d.ts",
            "import": "./dist/ner/index.js"
        },
        "./detect": {
            "types": "./dist/detect/index.d.ts",
            "import": "./dist/detect/index.js"
        },
        "./worker": {
            "types": "./dist/worker/index.d.ts",
            "import": "./dist/worker/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test": "vitest run --project unit",
        "test:watch": "vitest",
        "test:browser": "vitest run --project browser",
        "check:pkg": "publint && attw --pack . --profile esm-only",
        "test:all": "vitest run"
    },
    "peerDependencies": {
        "@huggingface/transformers": ">=3.7.0",
        "onnxruntime-web": ">=1.23.0",
        "pdfjs-dist": ">=5.0.0",
        "ppu-paddle-ocr": ">=6.0.0",
        "tesseract-wasm": ">=0.10.0",
        "tesseract.js": ">=7.0.0"
    },
    "peerDependenciesMeta": {
        "@huggingface/transformers": {
            "optional": true
        },
        "onnxruntime-web": {
            "optional": true
        },
        "pdfjs-dist": {
            "optional": true
        },
        "ppu-paddle-ocr": {
            "optional": true
        },
        "tesseract-wasm": {
            "optional": true
        },
        "tesseract.js": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@biomejs/biome": "^2.5.11",
        "@huggingface/transformers": "^3.8.1",
        "@vitest/browser": "^4.1.11",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "onnxruntime-web": "^1.29.0",
        "pdfjs-dist": "^6.2.108",
        "playwright": "^1.62.1",
        "ppu-paddle-ocr": "^6.4.3",
        "publint": "^0.3.24",
        "tesseract-wasm": "^0.11.0",
        "tesseract.js": "^7.0.0",
        "tsdown": "^0.22.14",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
